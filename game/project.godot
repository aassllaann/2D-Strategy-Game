; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="I Ching Grand Strategy: The Executor"
config/description="A 2D ink-wash strategy + visual novel game where players interpret I Ching hexagrams to shape war narratives."
config/version="0.1.0-dev"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DatabaseManager="*res://autoloads/DatabaseManager.gd"
GameState="*res://autoloads/GameState.gd"
SaveManager="*res://autoloads/SaveManager.gd"
AppSettings="*res://autoloads/AppSettings.gd"
AIManager="*res://autoloads/AIManager.gd"
SceneTransition="*res://autoloads/SceneTransition.gd"

[configuration]

config_version=5

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gdscript]

warnings/untyped_declaration=1
warnings/return_value_discarded=0

[input]

ui_confirm={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194309,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":false,"script":null)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
